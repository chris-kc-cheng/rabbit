          "type": "integer",
          "min": 3,
          "max": 4
        },
        "height": {
          "type": "integer",
          "min": 2,
          "max": 3
        }
      },
      "prompt": [
        {
          "type": "text",
          "value": "What is the volume of the rectangular prism?"
        }
      ],
      "answer": {
        "expression": "length * width * height",
        "format": "number"
      },
      "distractors": [
        {
          "id": "base-only",
          "misconception": "math.volume.used-base-area",
          "expression": "length * width",
          "feedback": "That is the base area. Multiply it by the prism height too."
        },
        {
          "id": "added-dimensions",
          "misconception": "math.volume.added-dimensions",
          "expression": "length + width + height",
          "feedback": "Volume counts cubic units, so multiply all three dimensions."
        },
        {
          "id": "one-cube-short",
          "misconception": "math.volume.missed-cube",
          "expression": "length * width * height - 1",
          "feedback": "Count every cubic unit in all {{height}} complete layers."
        }
      ],
      "hint": "Multiply length \u00d7 width \u00d7 height.",
      "explanation": "{{length}} \u00d7 {{width}} \u00d7 {{height}} = {{length * width * height}} cubic centimetres.",
      "visual": {
        "type": "solid",
        "kind": "rectangular-prism",
        "length": "length",
        "width": "width",
        "height": "height",
        "unit": "cm",
        "alt": "A rectangular prism measuring {{length}} by {{width}} by {{height}} centimetres."
      },
      "accessibility": {
        "screenReaderText": "Find the volume of a rectangular prism from its three dimensions."
      }
    }
  ]
}
