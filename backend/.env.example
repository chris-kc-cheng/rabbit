# Safe local-development defaults. Copy this file to the repository root as
# `.env`, then replace any values needed for your environment. Never put a real
# API key or production secret in this example file.
RABBIT_ADMIN_PASSWORD=rabbit-admin
RABBIT_DATABASE_HOST=localhost
RABBIT_DATABASE_PORT=5432
RABBIT_DATABASE_NAME=rabbit
RABBIT_DATABASE_USER=rabbit
RABBIT_DATABASE_PASSWORD=rabbit-local
RABBIT_JWT_SECRET=change-me
RABBIT_JWT_TTL_SECONDS=3600

# Obtain a key from Resend for activation emails. Leaving this blank disables
# activation-email delivery rather than embedding a credential in the project.
RESEND_API_KEY=
RABBIT_EMAIL_FROM="Rabbit <onboarding@resend.dev>"
RABBIT_PUBLIC_URL=http://localhost:8090
